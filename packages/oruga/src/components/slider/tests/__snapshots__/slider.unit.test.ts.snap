// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`OSlider tests > render correctly 1`] = `
"<div data-oruga="slider" class="o-slider">
  <div class="o-slider__track">
    <div class="o-slider__fill" style="width: 0%; left: 0%;"></div>
    <!--v-if-->
    <!-- Slot for additional slider ticks -->
    <div data-oruga="slider-thumb" class="o-slider__thumb-wrapper" style="left: 0%;">
      <div data-oruga="tooltip" class="o-tooltip">
        <div class="o-slider__thumb" tabindex="0" role="slider" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" aria-disabled="false" aria-orientation="horizontal" aria-describedby="v-0">
          <!--v-if-->
        </div>
        <!--teleport start-->
        <transition-stub name="fade" appear="false" persisted="false" css="true">
          <div id="v-0" class="o-tooltip__content" role="tooltip" style="position-area: top; position-try-fallbacks: flip-block, flip-inline, flip-block flip-inline; display: none;" data-position="top"><span class="o-tooltip__arrow"></span>0</div>
        </transition-stub>
        <!--teleport end-->
      </div>
    </div>
    <!--v-if-->
  </div>
</div>"
`;
